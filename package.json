{
  "name": "ludimila-reis-closet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test lib/exchanges/balance.test.ts lib/exchanges/outbound-complete.test.ts lib/cash/idempotency.test.ts lib/admin/dashboard-cash.test.ts lib/admin/nav.test.ts lib/orders/stock/reservation-scope.test.ts lib/config/checkout-shipping-charge.test.ts lib/payments/verify-infinitepay-payment.test.ts lib/admin-sale/payment-link-expiry.test.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:deploy:staging": "tsx scripts/turso-migrate.ts staging",
    "db:deploy:production": "tsx scripts/turso-migrate.ts production",
    "db:seed": "prisma db seed",
    "db:seed:staging": "DB_TARGET=staging prisma db seed",
    "db:seed:production": "DB_TARGET=production prisma db seed",
    "db:mark-paid": "tsx scripts/mark-order-paid.ts",
    "db:migrate-legacy-pending": "tsx scripts/migrate-legacy-pending-orders.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "iron-session": "^8.0.4",
    "next": "16.2.4",
    "next-cloudinary": "^6.17.5",
    "postcss": "^8.5.10",
    "prisma": "^7.7.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
