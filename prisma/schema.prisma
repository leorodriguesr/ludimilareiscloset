generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StockType {
  UNLIMITED
  LIMITED
}

enum UserRole {
  ADMIN
  CLIENT
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String
  cpf          String?
  /** Null quando a conta é só OAuth (ex.: Google). */
  passwordHash String?
  /** ID estável da conta Google (sub / id do userinfo). */
  googleId     String?    @unique
  /** URL da foto de perfil (fornecida pelo Google OAuth). */
  picture      String?
  role         UserRole   @default(CLIENT)
  createdAt    DateTime   @default(now())
  orders       Order[]
  favorites    Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

/** Pedido: pode ser guest (`userId` nulo) ou vinculado a usuário logado. */
model Order {
  id          String      @id @default(cuid())
  /** Número sequencial legível, ex.: #1, #2… */
  orderNumber Int?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  status    String      @default("pending_payment")
  total     Float
  /** Valor do frete (R$), validado no servidor na criação. */
  shippingAmount      Float   @default(0)
  /** Cotação SuperFrete escolhida no checkout (R$). */
  shippingQuotedPrice       Float?
  shippingDeliveryDaysMin   Int?
  shippingDeliveryDaysMax   Int?
  /** Valor debitado na SuperFrete ao gerar etiqueta (R$). */
  superfreteShippingPrice   Float?
  shippingServiceName String?
  destinationCep      String?
  /** Dados de contato e entrega coletados no checkout da loja. */
  recipientName       String?
  phone               String?
  cpf                 String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  paidAt                    DateTime?
  /** Método de pagamento escolhido: "pix" | "card" */
  paymentMethod             String?
  infinitePayTransactionNsu String?
  infinitePayInvoiceSlug    String?
  paymentCaptureMethod      String?
  /** ID do pagamento no Mercado Pago (pagamentos PIX). */
  mercadoPagoPaymentId      String?
  /** Status de envio: to_pack | packed | shipped | delivered | cancelled */
  shippingStatus            String    @default("to_pack")
  /** Código do serviço SuperFrete escolhido (1=PAC, 2=SEDEX, 3=Jadlog, 17=Mini, 31=Loggi). */
  shippingServiceId         Int?
  /** Status bruto retornado pela SuperFrete (pending, released, posted, delivered, cancelled). */
  superfreteStatus          String?
  /** Código de rastreio (disponível após released/posted). */
  trackingCode              String?
  /** Caixa ideal retornada pela cotação SuperFrete (para etiqueta). */
  packageHeightCm           Float?
  packageWidthCm            Float?
  packageLengthCm           Float?
  packageWeightKg           Float?
  /** ID do pedido criado na SuperFrete para esta etiqueta. */
  superfreteShipmentId      String?
  /** URL da etiqueta de envio (gerada pela SuperFrete). */
  labelUrl                  String?
  labelGeneratedAt          DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Float
  /** JSON: [{ pieceName, size, color }] — opções escolhidas por peça. */
  pieceSelectionsJson String?

  @@index([orderId])
}

model Category {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Section {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  order     Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  products  ProductSection[]
}

model ProductSection {
  productId String
  sectionId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([productId, sectionId])
}

model Product {
  id            String            @id @default(cuid())
  name          String
  price         Float
  installmentCount Int?
  pixPrice      Float?
  costPrice     Float?
  description   String?
  tag           String?
  videoUrl      String?
  stockType     StockType         @default(UNLIMITED)
  stockQuantity Int?
  weightGrams   Int?
  lengthCm      Float?
  widthCm       Float?
  heightCm      Float?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  images        ProductImage[]
  pieces        ProductPiece[]
  categories    ProductCategory[]
  sections      ProductSection[]
  orderItems    OrderItem[]
  favorites     Favorite[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  colorName String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPiece {
  id        String         @id @default(cuid())
  name      String
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colors    PieceColor[]
  sizes     PieceSize[]
  variants  PieceVariant[]
}

model PieceColor {
  id       String         @id @default(cuid())
  name     String
  hex      String?
  pieceId  String
  piece    ProductPiece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  variants PieceVariant[]
}

model PieceSize {
  id       String         @id @default(cuid())
  name     String
  pieceId  String
  piece    ProductPiece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  variants PieceVariant[]
}

/** Estoque por combinação cor × tamanho dentro de uma peça (ex.: Calça P Branca = 2). */
model PieceVariant {
  id        String       @id @default(cuid())
  quantity  Int          @default(0)
  pieceId   String
  colorId   String
  sizeId    String
  piece     ProductPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  color     PieceColor   @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size      PieceSize    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([pieceId, colorId, sizeId])
}

model StoreSettings {
  id             String @id @default("default")
  bannerImageUrl String @default("")

  /** Frete grátis habilitado na loja */
  freeShippingEnabled  Boolean @default(false)
  /** "always" = sempre grátis | "minimum_value" = grátis acima de um valor mínimo */
  freeShippingType     String  @default("minimum_value")
  /** Valor mínimo do carrinho (R$) para frete grátis (usado quando type = minimum_value) */
  freeShippingMinValue Float   @default(0)
  /** Dias úteis para embalar o pedido antes do envio (somados ao prazo do frete). */
  packagingDays        Int     @default(0)
}
