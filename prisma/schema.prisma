generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum StockType {
  UNLIMITED
  LIMITED
}

enum UserRole {
  ADMIN
  GESTOR
  CLIENT
}

enum OrderSource {
  CHECKOUT
  ADMIN_SALE
}

enum FulfillmentType {
  CARRIER
  ARRANGED
}

enum CustomerDataStatus {
  PENDING
  COMPLETE
}

enum PaymentChannel {
  GATEWAY
  MANUAL
}

enum DiscountMode {
  FIXED
  PERCENT
}

/** Tipos de evento para histórico futuro (OrderEvent). */
enum OrderEventType {
  CREATED
  PAYMENT_CONFIRMED
  CUSTOMER_DATA_COMPLETED
  LABEL_GENERATED
  SHIPPED
  DELIVERED
  CANCELLED
  UPDATED
  NOTE_ADDED
}

enum ExchangeKind {
  /** Troca: devolve itens e (opcionalmente) envia novos. */
  EXCHANGE
  /** Devolução pura: só retorno + crédito/reembolso. */
  RETURN
}

enum ExchangeStatus {
  AWAITING_RETURN
  RETURN_IN_TRANSIT
  RECEIVED
  READY_OUTBOUND
  OUTBOUND
  COMPLETED
  CANCELLED
}

enum CashLedgerDirection {
  IN
  OUT
}

enum CashLedgerKind {
  SALE
  EXCHANGE_BALANCE
  EXCHANGE_REFUND
  MANUAL
}

enum ExchangeReason {
  SIZE
  COLOR
  DEFECT
  REGRET
  WRONG_PRODUCT
  OTHER
}

enum ExchangeItemDirection {
  RETURN
  OUTBOUND
}

/** Destino da peça devolvida após conferência. */
enum ExchangeItemDisposition {
  RESELLABLE
  DAMAGED
  DISCARD
  INTERNAL_USE
}

enum ExchangeShippingType {
  RETURN
  OUTBOUND
}

/** Como a peça vai/volta: transportadora ou operação local. */
enum ExchangeShippingMethod {
  CARRIER
  STORE_PICKUP
  LOCAL_COURIER
}

enum ExchangeShippingPaidBy {
  STORE
  CUSTOMER
}

enum ExchangeBalanceStatus {
  NONE
  PENDING
  PAID
  WAIVED
  CREDIT_PENDING
  SETTLED
}

enum ExchangeEventType {
  CREATED
  REVERSE_LABEL_GENERATED
  RETURN_POSTED
  RECEIVED
  INSPECTED
  STOCK_RESTORED
  STOCK_DEBITED
  OUTBOUND_LABEL_GENERATED
  BALANCE_UPDATED
  BALANCE_PAID
  BALANCE_WAIVED
  BALANCE_REFUND_MARKED
  PAYMENT_LINK_CREATED
  COMPLETED
  CANCELLED
  NOTE_ADDED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String
  cpf          String?
  /** Null quando a conta é só OAuth (ex.: Google). */
  passwordHash String?
  /** ID estável da conta Google (sub / id do userinfo). */
  googleId     String?    @unique
  /** URL da foto de perfil (fornecida pelo Google OAuth). */
  picture      String?
  role         UserRole   @default(CLIENT)
  createdAt    DateTime   @default(now())
  orders       Order[]
  ordersCreated Order[]   @relation("OrdersCreatedByStaff")
  exchangesOpened Exchange[] @relation("ExchangesOpenedByStaff")
  favorites    Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

/** Pedido: pode ser guest (`userId` nulo) ou vinculado a usuário logado. */
model Order {
  id          String      @id @default(cuid())
  /** Número sequencial legível, ex.: #1, #2… */
  orderNumber Int?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  status    String      @default("pending_payment")
  /** Origem do pedido: checkout da loja ou venda avulsa do admin. */
  orderSource         OrderSource     @default(CHECKOUT)
  /** Staff que criou a venda avulsa (null no checkout). */
  createdByUserId     String?
  createdBy           User?           @relation("OrdersCreatedByStaff", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /** Modalidade de entrega. */
  fulfillmentType     FulfillmentType @default(CARRIER)
  /** Status do preenchimento de dados do cliente (venda avulsa). */
  customerDataStatus  CustomerDataStatus?
  /** Token exclusivo para o cliente preencher dados (venda avulsa). */
  customerDataToken   String?         @unique
  customerDataTokenExpiresAt DateTime?
  /** Token exclusivo para o cliente pagar via página pública (venda avulsa PIX). */
  paymentToken        String?         @unique
  paymentTokenExpiresAt DateTime?
  /** Canal de pagamento: gateway online ou registro manual. */
  paymentChannel      PaymentChannel?
  manualPaidByUserId  String?
  /** Observações da entrega (ex.: entregar após 18h). */
  deliveryNotes       String?
  /** Observações internas visíveis só para admin/gestor. */
  internalNotes       String?
  /** Entrega a combinar: quando o staff marcou como enviado. */
  arrangedShippedAt       DateTime?
  arrangedShippedByUserId String?
  /** Soma dos preços de catálogo efetivos × quantidade (antes de descontos admin). */
  subtotalOriginal    Float?
  /** Soma dos descontos por item aplicados pelo admin. */
  itemsDiscountTotal  Float           @default(0)
  /** Desconto geral sobre a venda. */
  orderDiscountMode   DiscountMode?
  orderDiscountValue  Float?
  orderDiscountAmount Float           @default(0)
  total     Float
  /** Valor do frete/entrega (R$), validado no servidor na criação. */
  shippingAmount      Float   @default(0)
  /** Cotação SuperFrete escolhida no checkout (R$). */
  shippingQuotedPrice       Float?
  shippingDeliveryDaysMin   Int?
  shippingDeliveryDaysMax   Int?
  /** Valor debitado na SuperFrete ao gerar etiqueta (R$). */
  superfreteShippingPrice   Float?
  shippingServiceName String?
  destinationCep      String?
  /** Dados de contato e entrega coletados no checkout da loja. */
  recipientName       String?
  phone               String?
  cpf                 String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  paidAt                    DateTime?
  /** Método de pagamento escolhido: "pix" | "card" */
  paymentMethod             String?
  infinitePayTransactionNsu String?
  infinitePayInvoiceSlug    String?
  paymentCaptureMethod      String?
  /** ID do pagamento no Mercado Pago (pagamentos PIX). */
  mercadoPagoPaymentId      String?
  /** Status de envio: to_pack (por embalar) | packed (por enviar) | shipped | delivered | cancelled */
  shippingStatus            String    @default("to_pack")
  /** Código do serviço SuperFrete escolhido (1=PAC, 2=SEDEX, 3=Jadlog, 17=Mini, 31=Loggi). */
  shippingServiceId         Int?
  /** Status bruto retornado pela SuperFrete (pending, released, posted, delivered, cancelled). */
  superfreteStatus          String?
  /** Código de rastreio (disponível após released/posted). */
  trackingCode              String?
  /** Caixa ideal retornada pela cotação SuperFrete (para etiqueta). */
  packageHeightCm           Float?
  packageWidthCm            Float?
  packageLengthCm           Float?
  packageWeightKg           Float?
  /** ID do pedido criado na SuperFrete para esta etiqueta. */
  superfreteShipmentId      String?
  /** URL da etiqueta de envio (gerada pela SuperFrete). */
  labelUrl                  String?
  labelGeneratedAt          DateTime?
  /** Mensagem quando a geração automática de etiqueta falhou após o pagamento. */
  labelAutoGenerateError    String?
  /** Motivo informado pelo admin ao cancelar a venda. */
  cancellationReason        String?
  cancelledAt               DateTime?
  /** Expiração fixa da intenção de compra (createdAt + 24h). Não renova. */
  expiresAt                 DateTime?
  expiredAt                 DateTime?
  /** Último recálculo de estoque, frete, preços e descontos antes de pagamento. */
  lastRecalculatedAt        DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items              OrderItem[]
  paymentAttempts    PaymentAttempt[]
  stockReservations  StockReservation[]
  events             OrderEvent[]
  exchanges          Exchange[]
  cashLedgerEntries  CashLedgerEntry[]

  @@index([userId, status])
  @@index([email, status])
  @@index([status, expiresAt])
  @@index([orderSource])
  @@index([fulfillmentType])
}

/** Troca / devolução vinculada a um pedido (não cria nova venda). */
model Exchange {
  id              String         @id @default(cuid())
  /** Número sequencial legível, ex.: #1, #2… */
  exchangeNumber  Int?
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind            ExchangeKind   @default(EXCHANGE)
  status          ExchangeStatus @default(AWAITING_RETURN)
  reason          ExchangeReason
  reasonNotes     String?
  notes           String?
  openedByUserId  String?
  openedBy        User?          @relation("ExchangesOpenedByStaff", fields: [openedByUserId], references: [id], onDelete: SetNull)
  receivedAt      DateTime?
  inspectedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?

  /** Soma dos itens devolvidos (crédito). */
  returnedItemsTotal   Float @default(0)
  /** Soma dos itens novos (débito). */
  newItemsTotal        Float @default(0)
  /** newItemsTotal - returnedItemsTotal. */
  productsDelta        Float @default(0)
  /** Fretes cobrados do cliente nesta troca. */
  shippingCustomerTotal Float @default(0)
  /** Saldo: positivo = cliente deve; negativo = crédito. */
  balanceAmount        Float @default(0)
  balanceStatus        ExchangeBalanceStatus @default(NONE)
  balancePaidAt        DateTime?
  balancePaidByUserId  String?
  balanceNotes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            ExchangeItem[]
  shippings        ExchangeShipping[]
  events           ExchangeEvent[]
  paymentAttempts  PaymentAttempt[]
  cashLedgerEntries CashLedgerEntry[]

  @@index([orderId])
  @@index([status])
  @@index([kind])
  @@index([createdAt])
}

model ExchangeItem {
  id                  String                @id @default(cuid())
  exchangeId          String
  exchange            Exchange              @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  direction           ExchangeItemDirection
  /** Linha original do pedido (itens RETURN). */
  orderItemId         String?
  productId           String?
  productName         String
  productImageUrl     String?
  quantity            Int
  unitPrice           Float
  lineTotal           Float
  pieceSelectionsJson String?
  pieceVariantId      String?
  /** Preenchido na conferência (só RETURN). */
  disposition         ExchangeItemDisposition?
  stockRestored       Boolean               @default(false)
  stockDebited        Boolean               @default(false)

  @@index([exchangeId])
  @@index([orderItemId])
  @@index([productId])
}

model ExchangeShipping {
  id                    String                 @id @default(cuid())
  exchangeId            String
  exchange              Exchange               @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  type                  ExchangeShippingType
  method                ExchangeShippingMethod @default(CARRIER)
  shippingServiceId     Int?
  shippingServiceName   String?
  quotedPrice           Float?
  /** Valor debitado na SuperFrete. */
  cost                  Float?
  paidBy                ExchangeShippingPaidBy @default(STORE)
  trackingCode          String?
  superfreteShipmentId  String?
  superfreteStatus      String?
  labelUrl              String?
  labelGeneratedAt      DateTime?
  packageHeightCm       Float?
  packageWidthCm        Float?
  packageLengthCm       Float?
  packageWeightKg       Float?
  /** pending | labeled | posted | delivered | cancelled */
  shippingStatus        String                 @default("pending")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([exchangeId])
  @@index([type])
}

model ExchangeEvent {
  id          String            @id @default(cuid())
  exchangeId  String
  exchange    Exchange          @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  type        ExchangeEventType
  actorUserId String?
  payloadJson String?
  createdAt   DateTime          @default(now())

  @@index([exchangeId, createdAt])
}

/** Histórico de eventos da venda (preparado para uso futuro). */
model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        OrderEventType
  actorUserId String?
  payloadJson String?
  createdAt   DateTime       @default(now())

  @@index([orderId, createdAt])
}

/** Tentativa de pagamento (pedido ou saldo de troca). */
model PaymentAttempt {
  id                    String    @id @default(cuid())
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /** Quando preenchido: cobrança do saldo da troca (não confirma o pedido). */
  exchangeId            String?
  exchange              Exchange? @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  /** order | exchange_balance */
  purpose               String    @default("order")
  /** Sequencial por Order: 1, 2, 3… */
  attemptNumber         Int
  paymentMethod         String
  gateway               String
  /** created | active | failed | superseded | expired | paid */
  status                String
  amount                Float
  /** mpOrderId (Mercado Pago) ou invoice slug (InfinitePay). */
  gatewayReference      String?
  gatewayTransactionId  String?
  failureReason         String?
  expiresAt             DateTime?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  @@unique([orderId, attemptNumber])
  @@unique([gateway, gatewayReference])
  @@index([orderId, status])
  @@index([exchangeId, status])
  @@index([gatewayReference])
}

/** Movimentações de caixa (vendas, diferença de troca, reembolsos). */
model CashLedgerEntry {
  id               String              @id @default(cuid())
  direction        CashLedgerDirection
  kind             CashLedgerKind
  amount           Float
  description      String
  orderId          String?
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  exchangeId       String?
  exchange         Exchange?           @relation(fields: [exchangeId], references: [id], onDelete: SetNull)
  paymentAttemptId String?
  actorUserId      String?
  createdAt        DateTime            @default(now())

  @@index([createdAt])
  @@index([direction, createdAt])
  @@index([kind])
  @@index([orderId])
  @@index([exchangeId])
}

/** Auditoria de webhooks/retornos de pagamento (inclui tentativas superseded rejeitadas). */
model PaymentWebhookEvent {
  id               String   @id @default(cuid())
  gateway          String
  source           String
  outcome          String
  orderId          String?
  paymentAttemptId String?
  gatewayReference String?
  reason           String?
  payloadJson      String?
  createdAt        DateTime @default(now())

  @@index([orderId])
  @@index([outcome])
  @@index([createdAt])
}

/** Reserva de estoque enquanto a Order estiver pendente (ou até pagamento/expiração). */
model StockReservation {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  /** Null quando o produto não usa matriz cor×tamanho. */
  pieceVariantId String?
  pieceVariant   PieceVariant? @relation(fields: [pieceVariantId], references: [id], onDelete: Restrict)
  quantity       Int
  createdAt      DateTime      @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([pieceVariantId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /** Referência opcional ao catálogo; null se o produto foi excluído. */
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /** Snapshot do produto no momento da venda (histórico independente do catálogo). */
  productName         String
  productDescription  String?
  productImageUrl     String?
  quantity  Int
  /** Preço de tabela do catálogo no momento da venda (product.price). */
  catalogListPrice      Float?
  /** Preço promocional do catálogo (ex.: pixPrice), se houver. */
  catalogPromoPrice     Float?
  /** Preço efetivo do catálogo antes de desconto admin (pix ou card). */
  catalogUnitPrice      Float?
  /** Desconto admin por item. */
  itemDiscountMode      DiscountMode?
  itemDiscountValue     Float?
  /** Valor total do desconto admin nesta linha (unitário × quantidade). */
  itemDiscountAmount    Float           @default(0)
  /** Subtotal original da linha (catalogUnitPrice × quantity). */
  lineSubtotalOriginal  Float?
  /** Subtotal final da linha (price × quantity). */
  lineSubtotalFinal     Float?
  /** Preço unitário final após descontos admin. */
  price     Float
  /** JSON: [{ pieceName, size, color }] — opções escolhidas por peça. */
  pieceSelectionsJson String?

  @@index([orderId])
  @@index([productId])
}

model Category {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model Section {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  order     Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  products  ProductSection[]
}

model ProductSection {
  productId String
  sectionId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([productId, sectionId])
}

model Product {
  id            String            @id @default(cuid())
  name          String
  price         Float
  installmentCount Int?
  pixPrice      Float?
  costPrice     Float?
  description   String?
  tag           String?
  videoUrl      String?
  stockType     StockType         @default(UNLIMITED)
  stockQuantity Int?
  weightGrams   Int?
  lengthCm      Float?
  widthCm       Float?
  heightCm      Float?
  /** Se false, o produto não aparece na vitrine / busca pública. */
  visibleOnSite Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  images        ProductImage[]
  pieces        ProductPiece[]
  categories    ProductCategory[]
  sections      ProductSection[]
  orderItems        OrderItem[]
  favorites         Favorite[]
  stockReservations StockReservation[]
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  order     Int     @default(0)
  colorName String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductPiece {
  id        String         @id @default(cuid())
  name      String
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  colors    PieceColor[]
  sizes     PieceSize[]
  variants  PieceVariant[]
}

model PieceColor {
  id       String         @id @default(cuid())
  name     String
  hex      String?
  pieceId  String
  piece    ProductPiece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  variants PieceVariant[]
}

model PieceSize {
  id       String         @id @default(cuid())
  name     String
  pieceId  String
  piece    ProductPiece   @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  variants PieceVariant[]
}

/** Estoque por combinação cor × tamanho dentro de uma peça (ex.: Calça P Branca = 2). */
model PieceVariant {
  id        String       @id @default(cuid())
  quantity  Int          @default(0)
  pieceId   String
  colorId   String
  sizeId    String
  piece     ProductPiece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  color     PieceColor   @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size              PieceSize          @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  stockReservations StockReservation[]

  @@unique([pieceId, colorId, sizeId])
}

model StoreSettings {
  id                   String @id @default("default")
  bannerImageUrl       String @default("")
  bannerMobileImageUrl String @default("")

  /** Frete grátis habilitado na loja */
  freeShippingEnabled  Boolean @default(false)
  /** "always" = sempre grátis | "minimum_value" = grátis acima de um valor mínimo */
  freeShippingType     String  @default("minimum_value")
  /** Valor mínimo do carrinho (R$) para frete grátis (usado quando type = minimum_value) */
  freeShippingMinValue Float   @default(0)
  /** Dias úteis para embalar o pedido antes do envio (somados ao prazo do frete). */
  packagingDays        Int     @default(0)
  /** Valor (R$) cobrado na venda avulsa quando a entrega é pelo entregador da loja. */
  storeDeliveryFee     Float   @default(0)
}
